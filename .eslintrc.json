{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "max-lines-per-function": [
      "error",
      {
        "max": 200,
        "skipBlankLines": true,
        "skipComments": true,
        "IIFEs": true
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 600,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["lib/sampleData.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 600,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
